{
  "name": "@euanmsm/skills",
  "version": "0.3.0",
  "description": "Shared Claude Code skills, written into a repository from one config file and kept in step with it",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/euanmsm/devkit.git",

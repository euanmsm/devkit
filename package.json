{
  "name": "devkit",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.11"
  },
  "scripts": {
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"packages/*/test/*.test.mjs\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "release": "npm run test && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "prettier": "^3.9.8"
  }
}
